{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .codex/hooks/inject-workflow-state.py",
            "timeout": 15,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?:trellis-implement|trellis-check|trellis-research)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .codex/hooks/inject-subagent-context.py",
            "timeout": 15,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .codex/hooks/session-start.py",
            "timeout": 15,
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
